#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Lanceur de l'application Suivi Loyers : trouve Python 3 puis démarre l'interface.
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
PY=""
for c in /opt/homebrew/bin/python3 /usr/local/bin/python3 \
         /Library/Frameworks/Python.framework/Versions/Current/bin/python3 /usr/bin/python3; do
  if [ -x "$c" ]; then
    if [ "$c" = /usr/bin/python3 ] && ! xcode-select -p >/dev/null 2>&1; then continue; fi
    if "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' 2>/dev/null; then PY="$c"; break; fi
  fi
done
if [ -z "$PY" ]; then
  r=$(osascript -e 'display dialog "Suivi Loyers a besoin de Python 3, qui fait partie des outils gratuits d’Apple.\n\nInstalle-les, puis relance l’application." buttons {"Annuler", "Installer"} default button "Installer" with icon caution with title "Suivi Loyers"' 2>/dev/null)
  case "$r" in *Installer*) xcode-select --install ;; esac
  exit 1
fi
DONNEES="${SUIVI_LOYERS_DOSSIER:-$HOME/SuiviLoyers}"
mkdir -p "$DONNEES"
export PYTHONDONTWRITEBYTECODE=1
echo "--- $(date '+%Y-%m-%d %H:%M:%S') lancement avec $PY" >>"$DONNEES/app.log"
"$PY" "$RES/serveur.py" >>"$DONNEES/app.log" 2>&1
rc=$?
if [ $rc -ne 0 ]; then
  # le serveur s'est arrêté sur une erreur : on l'affiche au lieu de ne rien faire
  detail=$(tail -n 6 "$DONNEES/app.log" | tr '"' "'" | tr '\\' '/')
  osascript -e "display dialog \"Suivi Loyers n'a pas pu démarrer (code $rc).\n\n$detail\n\nJournal complet : $DONNEES/app.log\" buttons {\"OK\"} default button \"OK\" with icon caution with title \"Suivi Loyers\"" >/dev/null 2>&1
fi
exit $rc
